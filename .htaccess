Options -Indexes
DirectoryIndex index.php
AddType application/manifest+json .webmanifest
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php
RewriteEngine On
RewriteBase /

# Canonical host: https://incorpsys.com. www redirects to non-www; plain HTTP on the live domain redirects to HTTPS.
# (Only these two hostnames are matched, so local and staging copies are not redirected.)
RewriteCond %{HTTP_HOST} ^www\.incorpsys\.com$ [NC]
RewriteRule ^ https://incorpsys.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^incorpsys\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://incorpsys.com%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options nosniff
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Frame-Options SAMEORIGIN
  # Long-lived cache is safe because asset() appends ?v=<file mtime> to every asset URL.
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# Internal files and folders are not public.
RewriteRule ^(includes|partials|content|tools|docs|phase-b-reserved)(/|$) - [R=404,L]
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
RewriteRule ^pages/_ - [R=404,L]
RewriteRule (^|/)(README[^/]*\.md|[^/]+\.csv)$ - [R=404,L]
RewriteRule ^enquiry/?$ - [R=404,L]

# Direct /pages/... requests redirect to their clean URL (only the original request, not internal rewrites).
RewriteCond %{THE_REQUEST} \s/pages/([^/.\s?]+)/([^/.\s?]+)/(index\.php)?[\s?]
RewriteRule ^ /%1/%2/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/pages/([^/.\s?]+)/(index\.php)?[\s?]
RewriteRule ^ /%1/ [R=301,L]

# Never rewrite real files/directories.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Add the trailing slash used by canonical URLs.
RewriteRule ^([^/.]+)/([^/.]+)$ /$1/$2/ [R=301,L]
RewriteRule ^([^/.]+)$ /$1/ [R=301,L]

# Clean content URLs: /uae/ and /uae/company-registration/ (only when the page file exists).
RewriteCond %{DOCUMENT_ROOT}/pages/$1/$2/index.php -f
RewriteRule ^([^/.]+)/([^/.]+)/$ pages/$1/$2/index.php [L,QSA]
RewriteCond %{DOCUMENT_ROOT}/pages/$1/index.php -f
RewriteRule ^([^/.]+)/$ pages/$1/index.php [L,QSA]
