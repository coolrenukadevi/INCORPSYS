Options -Indexes
RewriteEngine On
RewriteBase /

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options nosniff
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Frame-Options SAMEORIGIN
</IfModule>
<FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2)$">
  Header set Cache-Control "public, max-age=2592000, immutable"
</FilesMatch>

# Never rewrite real files/directories.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean content URLs: /uae/company-registration/
RewriteRule ^([^/.]+)/([^/.]+)/?$ pages/$1/$2/index.php [L,QSA]
RewriteRule ^([^/.]+)/?$ pages/$1/index.php [L,QSA]
